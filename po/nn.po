msgid "Builder"
msgstr "Byggjar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:8
msgid "Create applications for GNOME"
msgstr "Lage appar til GNOME"

#. developer_name tag deprecated with Appstream 1.0
#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:10
#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:12
msgid "Christian Hergert"
msgstr "Christian Hergert"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:16
msgid ""
"Builder is an actively developed Integrated Development Environment for "
"GNOME. It combines integrated support for essential GNOME technologies such "
"as GTK+, GLib, and GNOME APIs with features that any developer will "
"appreciate, like syntax highlighting and snippets."
msgstr ""
"Builder er eit aktivt utvikla integrert utviklingsmiljø for GNOME. Det "
"kombinerer integrert støtte for vesentlege GNOME-teknologiar som GTK+, GLib "
"og GNOME-API-ar med funksjonar som kvar utviklar vil setje pris på, slik som"
" syntaksutheving og snippets."

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:22
msgid ""
"You can rely on predictable releases of Builder with each new release of "
"GNOME every six months."
msgstr ""
"Du kan stole på føreseielege utgjevingar av Builder med kvar ny utgjeving av"
" GNOME sju månader."

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:26
msgid "Features:"
msgstr "Eigenskapar:"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:28
msgid "Built in syntax highlighting for many languages"
msgstr "Innebygd syntaksutheving for mange språk"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:29
msgid "Side-by-side code editors"
msgstr "Kodeeditorar ved sida av kvarandre"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:30
msgid "Multi-monitor support"
msgstr "Fleirskjermstøtte"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:31
msgid "Code overview mini-map"
msgstr "Kodeoversyn minikart"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:32
msgid "Integration with Git"
msgstr "Integrasjon med Git"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:33
msgid ""
"Integration with Autotools, Cargo, CMake, Gradle, Meson, Maven, Make, "
"PHPize, and Waf"
msgstr ""
"Integrasjon med Autotools, Cargo, CMake, Gradle, Meson, Maven, Make, PHPize "
"og Waf"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:34
msgid "Clang based auto-completion, semantic highlighting, and diagnostics"
msgstr "Clang-basert auto-fullføring, semantisk utheving og diagnostikk"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:35
msgid "Python based auto-completion, semantic highlighting, and diagnostics"
msgstr "Python-basert auto-fullføring, semantisk utheving og diagnostikk"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:36
msgid "Vala based auto-completion and diagnostics"
msgstr "Val basert på autofullføring og diagnostikk"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:37
msgid "Auto indentation support for C, Python, Vala, and XML"
msgstr "Auto-innrykkstøtte for C, Python, Vala og XML"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:38
msgid "HTML, Markdown, and reStructuredText, and Sphinx live preview"
msgstr ""
"HTML, Markdown og reStructuredText, og Sphinx-forhandsvising i sanntid"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:39
msgid "Optional Vim, Emacs, and SublimeText style editing"
msgstr "Valfri redigering i Vim-, Emacs- og SublimeText-stil"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:40
msgid "An integrated software profiler for native applications"
msgstr "Ein integrert programvareprofiler for native appar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:41
msgid "An integrated debugger for native applications"
msgstr "Ein integrert feilsøkar for native app-ar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:42
msgid "Support for building with jhbuild and flatpak runtimes"
msgstr "Støtte for å byggje med jhbuild og flatpak-tenarar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:43
msgid "Support for viewing TODOs found within your code base"
msgstr "Støtte for å sjå TODO-ar i koden din"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:44
msgid "Fast fuzzy text search across files and symbols"
msgstr "Rask fuzzy-tekstsøk på tvers av filer og symbol"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:45
msgid "Arduino integration with arduino-cli"
msgstr "Arduino-integrasjon med arduino-cli"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:51
msgid "IDE"
msgstr "IDE"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:52
msgid "integrated development environment"
msgstr "integrert utviklingsmiljø"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:53
msgid "code editor"
msgstr "kodeeditor"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:54
msgid "coding"
msgstr "koding"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:55
msgid "programming"
msgstr "programmering"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:56
msgid "software developers"
msgstr "programvareutviklarar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:57
msgid "software development"
msgstr "programvareutvikling"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:58
msgid "compiling"
msgstr "kompilerer"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:59
msgid "building"
msgstr "bygning"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:60
msgid "runtimes"
msgstr "køyretenarar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:61
#: src/libide/plugins/ide-plugin.c:337 src/plugins/sdkui/tweaks.ui:9
msgid "SDKs"
msgstr "SDK-ar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:62
msgid "GTK inspector"
msgstr "GTK-inspektor"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:63
msgid "D-Bus inspector"
msgstr "D-Bus-inspektør"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:64
msgid "debugger"
msgstr "debugg"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:65
msgid "debugging"
msgstr "feilsøking"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:67
msgid "memory leaks detector"
msgstr "minnelekkasjedetektor"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:69
msgid "unit tests"
msgstr "einingstestar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:70
msgid "automated testing"
msgstr "automatisert testing"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:71
msgid "documentation"
msgstr "dokumentasjon"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:72
msgid "autocompletion"
msgstr "autoutfylling"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:73
msgid "profiler"
msgstr "profileringsverktøy"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:74
msgid "profiling"
msgstr "profilering"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:110
msgid "Debug with the GNU debugger"
msgstr "Feilsøk med GNU-feilsøkjaren"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:114
msgid "Quickly access your projects"
msgstr "Få rask tilgang til prosjekta dine"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:118
msgid "Create new projects from a variety of templates"
msgstr "Lag nye prosjekt frå eit utval malar"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:122
msgid "Integration with Git to clone your projects"
msgstr "Integrasjon med Git for å klone prosjekta dine"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:126
msgid "The source code editor"
msgstr "Kjeldekodeeditoren"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:130
msgid "Fast global fuzzy search"
msgstr "Fast global fuzzy-søk"

#: data/appdata/org.gnome.Builder.metainfo.xml.in.in:134
msgid "Use the minimap to see more of the file"
msgstr "Bruk minikartet for å sjå meir av fila"

#: data/gsettings/org.gnome.builder.build.gschema.xml:6
#: src/plugins/buildui/tweaks.ui:264
msgid "Build Parallelism"
msgstr "Bygg parallellisme"

#: data/gsettings/org.gnome.builder.build.gschema.xml:7
msgid ""
"Number of workers to use when performing builds. -1 for sensible default. 0 "
"for number of CPU."
msgstr ""
"Talet på arbeidarar som skal brukast når bygg vert utført. -1 for fornuftig "
"standard. 0 for talet på CPU."

#: data/gsettings/org.gnome.builder.build.gschema.xml:11
msgid "Clear build logs"
msgstr "Tømm byggloggar"

#: data/gsettings/org.gnome.builder.build.gschema.xml:12
msgid "If enabled, build log pane will be cleared on rebuild."
msgstr "Viss aktivert, vert byggeloggvindauget tømt ved nybygging."

#: data/gsettings/org.gnome.builder.build.gschema.xml:16
msgid "Show Log When Building"
msgstr "Vis logg når du byggjer"

#: data/gsettings/org.gnome.builder.build.gschema.xml:17
msgid "If enabled, the build log will be raised when a build starts"
msgstr "Viss det er aktivert, vert byggloggen heva når eit bygg byrjar"

#: data/gsettings/org.gnome.builder.build.gschema.xml:21
msgid "Allow network when metered"
msgstr "Løyv nettverk når det er målt"

#: data/gsettings/org.gnome.builder.build.gschema.xml:22
msgid ""
"Enable automated transfers upon building such as SDK downloads and "
"dependencies when connection is metered."
msgstr ""
"Slå på automatisk overføring ved bygging, slik som nedlasting av SDK og "
"avhengnader når tilkoplinga er datakvota."

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:5
msgid "Ctags based autocompletion"
msgstr "Ctags-basert autoutfylling"

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:6
msgid "Use Ctags for autocompletion."
msgstr "Bruk Ctags for autoutfylling."

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:10
msgid "Enable semantic highlighting"
msgstr "Slå på semantisk utheving"

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:11
msgid ""
"If enabled, additional highlighting will be provided in supported languages "
"based on information extracted from the source code."
msgstr ""
"Viss det er aktivert, vert det lagt til ekstra utheva tekst i støtta språk "
"basert på informasjon henta frå kjeldekoden."

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:15
msgid "Path to ctags executable"
msgstr "Sti til ctags-køyrbar fil"

#: data/gsettings/org.gnome.builder.code-insight.gschema.xml.in:16
msgid "The path to the ctags executable on the system."
msgstr "Stien til ctags-køyrbar fil på systemet."

#: data/gsettings/org.gnome.builder.debug.gschema.xml:5
msgid "Debugger Breakpoint at Main"
msgstr "Førebrot i debugger ved hovud"

#: data/gsettings/org.gnome.builder.debug.gschema.xml:6
msgid "Debugger should automatically insert breakpoint at main() function."
msgstr ""
"Feilsøkaren skal automatisk setje eit stoppunkt ved main()-funksjonen."

#: data/gsettings/org.gnome.builder.debug.gschema.xml:10
msgid "Debugger Breakpoint at Criticals"
msgstr "Fjern debugg-brytpunkt ved kritiske feil"

#: data/gsettings/org.gnome.builder.debug.gschema.xml:11
msgid ""
"Debugger should automatically insert breakpoint at g_critical() function."
msgstr ""
"Feilsøkjaren skal automatisk setje brotpunkt ved g_critical()-funksjonen."

#: data/gsettings/org.gnome.builder.debug.gschema.xml:15
msgid "Debugger Breakpoint at Warnings and Criticals"
msgstr "Førehandsinnstilling for feilsøking ved åtvaringar og kritiske feil"

#: data/gsettings/org.gnome.builder.debug.gschema.xml:16
msgid ""
"Debugger should automatically insert breakpoint at g_warning() and "
"g_critical function."
msgstr ""
"_Feilsøkjaren skal automatisk setje brotpunkt ved g_warning() og gcritical-"
"funksjonen."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:19
msgid "Restore last position"
msgstr "Gjenopprett siste posisjon"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:20
msgid "Jump to the last position when reopening a file"
msgstr "Hopp til siste posisjon når du opnar ei fil på nytt"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:24
msgid "Show modified lines"
msgstr "Vis endra linjer"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:25
msgid ""
"If enabled, the editor will show line additions and changes next to the "
"source code."
msgstr ""
"Viss det er slått på, vil redigeringa vise linjetillegg og endringar ved "
"sida av kjeldekoden."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:29
msgid "Show diagnostics next to line number"
msgstr "Vis diagnose ved sidan av linjenummeret"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:30
msgid ""
"If enabled, the editor will show diagnostics to the left to the line numbers."
msgstr ""
"Dersom det er slått på, vil redigeringa vise feilmeldingar til venstre for "
"linjenummar."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:34
msgid "Highlight current line"
msgstr "Uthev gjeldande linje"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:35
msgid "If enabled, the editor will highlight the line containing the cursor."
msgstr "Viss aktivert, vil redigeringa markere linja der markøren står."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:39
msgid "Highlight matching brackets"
msgstr "Marker samsvarande klammepar"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:40
msgid "If enabled, the editor will highlight matching brackets."
msgstr "Viss aktivert, vil redigeringa markere samsvarande klammer."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:44
msgid "Show line numbers"
msgstr "Vis linjenummer"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:45
msgid "If enabled, the editor will show line numbers."
msgstr "Viss aktivert, vil redigeringa vise linjenummer."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:49
msgid "Show relative line numbers"
msgstr "Vis relative linjenummer"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:50
msgid "If enabled, the editor will show relative line numbers."
msgstr "Viss det er slått på, vil redigeringa vise relative linjenummer."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:54
msgid "Use line selection styling"
msgstr "Bruk linjeval-stil"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:55
msgid ""
"If enabled, the editor will use selected style for line numbers for whole "
"lines selected."
msgstr ""
"Viss det er aktivert, vil redigeringa bruke valt stil for linjenummer for "
"heile linjene som er valde."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:59
#: src/plugins/editorui/tweaks.ui:500
msgid "Smart Backspace"
msgstr "Smart rettetast"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:60
msgid ""
"Backspace will remove additional spaces to keep you aligned to the "
"indentation size."
msgstr ""
"Tilbakestille vil fjerne ekstra mellomrom for å halde deg på linje med "
"innrykksstorleiken."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:70
#: src/plugins/editorui/tweaks.ui:512
msgid "Smart Home/End"
msgstr "Smart Home/Slutt"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:71
msgid "Modifies the behavior of Home/End keys."
msgstr "Endrar oppførselen til Home/End-tastane."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:75
msgid "Show grid lines"
msgstr "Vis rutenettlinjer"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:76
msgid "If enabled, the editor will show grid lines in the document."
msgstr "Dersom det er aktivert, vil redigeringa vise rutenett i dokumentet."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:80
msgid "If enabled, the editor will respect the font-name setting."
msgstr ""
"Viss aktivert, vil redigeringa ta omsyn til innstillinga for font-namn."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:84
msgid ""
"This setting is only respected if the use-custom-font setting is enabled."
msgstr ""
"Denne innstillinga vert berre respektert viss innstillinga brukar-tilpassa-"
"font er slått på."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:96
msgid "Overview Map Policy"
msgstr "Oversyn over kartpolicy"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:97
msgid "When the overview map should be displayed."
msgstr "Når oversiktskartet skal visast."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:101
#: src/plugins/editorui/tweaks.ui:283
msgid "Draw Spaces"
msgstr "Vis mellomrom"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:102
msgid "The various types of space to draw in the editor."
msgstr "Dei ulike typane teikneflate i editoren."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:111
#: src/plugins/editorui/tweaks.ui:82
msgid "Wrap Text"
msgstr "Bryt tekst"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:112
msgid "The way to wrap a long line of text for a better visibility."
msgstr "Måten å bryte ei lang tekstlinje på for betre synlegheit."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:116
msgid "Autosave Enabled"
msgstr "Autosave slått på"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:117
msgid "Enable or disable autosave feature."
msgstr "Slå på eller av automatisk lagring."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:122
msgid "Autosave Frequency"
msgstr "Auto-lagringsfrekvens"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:123
msgid "The number of seconds after modification before auto saving."
msgstr "Talet på sekund etter endring før auto-lagring."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:128
msgid "Completion Row Count"
msgstr "Fullført radetal"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:129
msgid "The number of completion rows to display to the user."
msgstr "Talet på fullførte rader som skal visast til brukaren."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:134
#: src/plugins/editorui/tweaks.ui:65
msgid "Line Height"
msgstr "Linjehøgd"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:135
msgid "The line height to use for the selected font."
msgstr "Linjehøgda for skrifttypen som er vald."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:139
msgid "Interactive Completion"
msgstr "Interaktiv fullføring"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:140
msgid ""
"If enabled, Builder will automatically display completion proposals as you "
"type."
msgstr ""
"Viss det er aktivert, vil Builder automatisk vise fullføringsforslag medan "
"du skriv."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:145
msgid "Minimum characters for matching selection."
msgstr "Minimumt tal teikn for å treffe utvalet."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:146
msgid "Specify the minimum number of characters for selection matching."
msgstr "Angi det minste talet på teikn for utval."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:150
msgid "Enable Snippets"
msgstr "Tillat snuttar"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:151
msgid ""
"Allow expanding snippets from the editor by pressing tab after the snippet "
"trigger."
msgstr ""
"Låt utviding av utdrag frå redigeringa ved å trykkje tab etter "
"utdragutløysaren."

#: data/gsettings/org.gnome.builder.editor.gschema.xml:155
msgid "Select First Completion"
msgstr "Vel fyrste fullføring"

#: data/gsettings/org.gnome.builder.editor.gschema.xml:156
msgid "Automatically select the first auto-completion entry."
msgstr "Vel automatisk det fyrste auto-fullfør-oppslaget."

#: data/gsettings/org.gnome.builder.editor.language.gschema.xml:42
msgid "Spaces Style"
msgstr "Stil for rommet"

#: data/gsettings/org.gnome.builder.editor.language.gschema.xml:43
msgid "How to apply spaces when reformatting text."
msgstr "Slik legg du inn mellomrom når du formaterer tekst på nytt."

#: data/gsettings/org.gnome.builder.extension-type.gschema.xml:5
msgid "Enabled"
msgstr "Aktivert"

#: data/gsettings/org.gnome.builder.extension-type.gschema.xml:6
msgid "If the type within the extension is enabled."
msgstr "Viss utvidingstypen er påslått."

#: data/gsettings/org.gnome.builder.gschema.xml:5
msgid "Window size"
msgstr "Vindaugestorleik"

#: data/gsettings/org.gnome.builder.gschema.xml:6
msgid "Window size (width and height)."
msgstr "Vindaugstorleik (breidde og høgd)."

#: data/gsettings/org.gnome.builder.gschema.xml:10
msgid "Window maximized"
msgstr "Vindauget maksimert"

#: data/gsettings/org.gnome.builder.gschema.xml:11
msgid "Window maximized state"
msgstr "Vindauga maksimert tilstand"

#: data/gsettings/org.gnome.builder.gschema.xml:20
msgid "Style Variant"
msgstr "Stilvariant"

#: data/gsettings/org.gnome.builder.gschema.xml:21
msgid ""
"Use the light or dark variant of the GTK theme and/or GtkSourceView style "
"scheme."
msgstr ""
"Bruk lys eller mørk variant av GTK-temaet og/eller GtkSourceView-"
"stilskjemaet."

#. Translators: This is the default directory name for user’s
#. projects. Do NOT change the ASCII double quotes ("") to your
#. language’s convention, e.g. do not use “” or »«.
#: data/gsettings/org.gnome.builder.gschema.xml:27
msgid "\"Projects\""
msgstr "«Prosjekt»"

#: data/gsettings/org.gnome.builder.gschema.xml:28
msgid "Projects directory"
msgstr "Prosjektmappe"

#: data/gsettings/org.gnome.builder.gschema.xml:29
msgid "Directory for all Builder projects."
msgstr "Mappe for alle Builder-prosjekt."

#: data/gsettings/org.gnome.builder.gschema.xml:33
msgid "Restore Session"
msgstr "Gjenopprett økt"

#: data/gsettings/org.gnome.builder.gschema.xml:34
msgid "Restores the projects previous session when loading."
msgstr "Gjenopprettar det førre prosjektet frå økta når det vert lada."

#: data/gsettings/org.gnome.builder.gschema.xml:38
msgid "Clear build caches at startup"
